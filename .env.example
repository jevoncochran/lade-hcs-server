# Copy to .env for local development, and to .env.test (pointing at a
# separate lade_hcs_test database, NODE_ENV=test) for e2e tests.
# Every value is checked at startup (src/config/env.validation.ts); the API
# won't start if one is invalid.
# Never point local or staging at a database with real patient data.

NODE_ENV=development
PORT=4000

# Required
DATABASE_URL="postgresql://USER@localhost:5432/lade_hcs_dev"
SITE_URL=http://localhost:3000

# PHI encryption keys. Generate local values with `npm run keys:generate`
# and paste them here. Never reuse local keys anywhere else.
ENCRYPTION_KEYS=k1:REPLACE_ME
ENCRYPTION_ACTIVE_KEY_ID=k1
BLIND_INDEX_KEY=REPLACE_ME

# Accounts (defaults shown)
TERMS_VERSION=2026-10-draft

# Email. "log" prints emails to the server log; "ses" sends them with Amazon
# SES in AWS_REGION (the MAIL_FROM domain must be verified there). The SES
# keys belong to an IAM user allowed only ses:SendEmail; leave them empty on
# AWS hosting with a role.
MAIL_TRANSPORT=log
MAIL_FROM=Lade Health Care Services <no-reply@ladehcs.com>
MAIL_REPLY_TO=info@ladehcs.com
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
AUTH_RATE_LIMIT_PER_MINUTE=10
MILEAGE_PROVIDER=estimate

# Amazon Location Service (when MILEAGE_PROVIDER=aws): an API key allowing
# geo-places Autocomplete/GetPlace/Geocode and geo-routes CalculateRoutes,
# with no referrer restriction. No real rider addresses before the AWS BAA.
AWS_REGION=us-east-1
AWS_LOCATION_API_KEY=
PAYMENT_PROVIDER=fake

# Stripe (when PAYMENT_PROVIDER=stripe). Test keys from the Stripe Dashboard →
# Developers → API keys. The webhook secret is optional in development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Booking rules (defaults shown; omit to use them)
MIN_NOTICE_HOURS=24
LONG_DISTANCE_MAX_MILES=50
LATE_CANCEL_WINDOW_MINUTES=120
PENDING_PAYMENT_EXPIRY_MINUTES=60
BUSINESS_TIMEZONE=America/New_York
